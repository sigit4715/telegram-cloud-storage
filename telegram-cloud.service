[Unit]
Description=Telegram Cloud Storage Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/data/telegram-cloud
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/data/.venv-scrapling/bin/python3 /opt/data/telegram-cloud/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
