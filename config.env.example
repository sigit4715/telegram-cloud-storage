# ============================================================
# Telegram Cloud Storage - Config
# Copy file ini ke config.env dan isi nilai berikut
# ============================================================

# Dari https://my.telegram.org → API development tools
API_ID=1234567
API_HASH=abcdef0123456789abcdef0123456789

# Bot token dari @BotFather (facodegm_bot)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Nomor HP akun userbot (format internasional, misal: 62812xxxxxxx)
# Dipakai saat login pertama kali (Telethon kirim kode verifikasi)
PHONE=62812xxxxxxx

# Private channel tujuan (username/link, misal: @nama_channel_rahasia)
# Atau "me" untuk Saved Messages
CHANNEL=@nama_channel_rahasia

# User ID yang diizinkan (pisahkan koma). Kosongkan = semua bisa upload
ALLOWED_USERS=
